load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_library", "py_test")
load("@rules_foreign_cc//foreign_cc:defs.bzl", "configure_make")

package(default_visibility = ["//visibility:public"])

py_library(
  name = "manafold_lib",
  srcs = glob(
    ["src/manafold/**/*.py"],
    exclude = ["src/manafold/cli/__main__.py"],
  ),
  imports = ["src"],
  deps = [
    "@pypi//numpy",
    "@pypi//psycopg",
    "@pypi//psycopg_binary",
    "@pypi//pyarrow",
    "@pypi//torch",
  ],
)

py_binary(
  name = "manafold",
  srcs = ["src/manafold/cli/__main__.py"],
  main = "src/manafold/cli/__main__.py",
  imports = ["src"],
  deps = [":manafold_lib"],
)

configure_make(
  name = "gnu_patch",
  configure_in_place = True,
  lib_name = "gnu_patch",
  lib_source = "@gnu_patch_src//:source",
  out_binaries = ["patch"],
  out_include_dir = "",
  visibility = ["//visibility:private"],
)

py_binary(
  name = "build_onnxruntime",
  srcs = ["scripts/build_onnx.py"],
  main = "scripts/build_onnx.py",
  args = [
    "--onnxruntime-source=$(rlocationpath @onnxruntime_src//:VERSION_NUMBER)",
    "--source-id=8f0278c77bf44b0cc83c098c6c722b92a36ac4b5",
    "--ninja-executable=$(rlocationpath @rules_foreign_cc//toolchains/private:ninja_tool)",
    "--patch-executable=$(rlocationpath :gnu_patch)",
  ],
  data = [
    ":gnu_patch",
    "@onnxruntime_src//:VERSION_NUMBER",
    "@onnxruntime_src//:source",
    "@rules_foreign_cc//toolchains/private:ninja_tool",
  ],
  deps = [
    "@pypi//flatbuffers",
    "@pypi//packaging",
  ],
)

py_binary(
  name = "export_onnx",
  srcs = ["scripts/export_onnx.py"],
  main = "scripts/export_onnx.py",
  imports = ["src"],
  deps = [
    ":manafold_lib",
    "@pypi//onnx",
    "@pypi//onnxruntime",
  ],
)

py_test(
  name = "schema_tests",
  srcs = ["tests/test_schemas.py"],
  main = "tests/test_schemas.py",
  imports = ["src"],
  deps = [":manafold_lib"],
)

py_test(
  name = "dataset_check_tests",
  srcs = ["tests/test_dataset_checks.py"],
  main = "tests/test_dataset_checks.py",
  imports = ["src"],
  deps = [":manafold_lib"],
)

py_test(
  name = "model_input_tests",
  srcs = ["tests/test_model_inputs.py"],
  main = "tests/test_model_inputs.py",
  imports = ["src"],
  deps = [":manafold_lib"],
)

py_test(
  name = "model_target_tests",
  srcs = ["tests/test_model_targets.py"],
  main = "tests/test_model_targets.py",
  imports = ["src"],
  deps = [":manafold_lib"],
)

py_test(
  name = "family_backoff_tests",
  srcs = ["tests/test_family_backoff.py"],
  main = "tests/test_family_backoff.py",
  imports = ["src"],
  deps = [":manafold_lib"],
)

py_test(
  name = "card_ranking_tests",
  srcs = ["tests/test_card_ranking.py"],
  main = "tests/test_card_ranking.py",
  imports = ["src"],
  deps = [":manafold_lib"],
)

py_test(
  name = "cli_tests",
  srcs = ["tests/test_cli.py"],
  main = "tests/test_cli.py",
  imports = ["src"],
  deps = [":manafold_lib"],
)

[
  py_test(
    name = name,
    srcs = [src],
    main = src,
    imports = ["src"],
    deps = [":manafold_lib"],
  )
  for name, src in (
    ("anchor_gate_tests",      "tests/test_anchor_gate.py"),
    ("causal_target_tests",    "tests/test_causal_targets.py"),
    ("dataset_build_tests",    "tests/test_dataset_build.py"),
    ("hyperbolic_tests",       "tests/test_hyperbolic.py"),
    ("lorentz_tests",          "tests/test_lorentz.py"),
    ("mtgo_database_tests",    "tests/test_mtgo_database.py"),
    ("package_boundary_tests", "tests/test_package_boundaries.py"),
    ("product_manifold_tests", "tests/test_product_manifold.py"),
    ("supcon_tests",           "tests/test_supcon.py"),
  )
]

py_test(
  name = "onnx_export_tests",
  srcs = [
    "scripts/export_onnx.py",
    "tests/test_onnx_export.py",
  ],
  main = "tests/test_onnx_export.py",
  imports = [
    ".",
    "src",
  ],
  deps = [
    ":manafold_lib",
    ":model_test_support",
    "@pypi//onnx",
    "@pypi//onnxruntime",
  ],
)

py_library(
  name = "model_test_support",
  srcs = ["tests/model_test_support.py"],
  imports = [
    ".",
    "src",
  ],
  visibility = ["//visibility:private"],
  deps = [":manafold_lib"],
)

[
  py_test(
    name = name,
    srcs = [src],
    main = src,
    imports = [
      ".",
      "src",
    ],
    deps = [
      ":manafold_lib",
      ":model_test_support",
    ],
  )
  for name, src in (
    ("auto_ontology_tests",    "tests/test_auto_ontology.py"),
    ("classifier_tests",       "tests/test_classifiers.py"),
    ("saved_model_tests",      "tests/test_saved_models.py"),
    ("model_data_tests",       "tests/test_model_data.py"),
    ("model_evaluation_tests", "tests/test_model_evaluation.py"),
    ("model_evidence_tests",   "tests/test_model_evidence.py"),
    ("model_experiment_tests", "tests/test_model_experiments.py"),
    ("model_training_tests",   "tests/test_model_training.py"),
  )
]

py_test(
  name = "validation_tests",
  srcs = ["tests/test_validation.py"],
  main = "tests/test_validation.py",
  imports = ["src"],
  deps = [":manafold_lib"],
)
